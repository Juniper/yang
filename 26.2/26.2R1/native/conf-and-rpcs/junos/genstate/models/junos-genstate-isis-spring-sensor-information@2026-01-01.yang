 module junos-genstate-isis-spring-sensor-information {
   yang-version 1;
   namespace "http://yang.juniper.net/junos/genstate/isis-spring-sensor-information";
   prefix jgissi;

   import junos-genstate {
     prefix jgs;
     revision-date 2026-01-01;
   }

   import junos-common-types {
     prefix jt;
     revision-date 2026-01-01;
   }

   organization
     "Juniper Networks, Inc.";

   contact
     "Juniper Networks, Inc.

      1133 Innovation Way
      Sunnyvale, CA 94089

      +1 888 314-5822

      E-mail: yang-support@juniper.net";

   description
      "Junos genstate Yang module for isis-spring-sensor-information.

      Copyright (c) 2026 Juniper Networks, Inc.
      All rights reserved.";

   revision 2026-01-01 {
     description "Junos: 26.2R1.7";
   }

   grouping isis-spring-sensor-information-top {
     description
       "Top-level grouping";
     container isis-spring-sensor-information {
       description
         "Top-level container";
       leaf isis-spring-sensor-information-attribute {
         type string;
       }
       container isis-sensor-ingress {
         description
           "ISIS SPRING ingress sensor information";
         list isis-sensor-ingress-entries {
           key "ingress-sensor-name";
           leaf ingress-sensor-name {
             type string;
           }
           leaf ingress-sensor-id {
             type int32;
           }
         }
       }
       container isis-sensor-egress {
         description
           "ISIS SPRING egress sensor information";
         list isis-sensor-egress-entries {
           key "egress-sensor-name";
           leaf egress-sensor-name {
             type string;
           }
           leaf egress-sensor-id {
             type int32;
           }
         }
       }
       container isis-sensor-per-sid {
         description
           "ISIS SPRING Per Sid ingress sensor information";
         list isis-sensor-per-sid-entries {
           key "per-sid-sensor-name";
           leaf per-sid-sensor-name {
             type string;
           }
           leaf per-sid-sensor-id {
             type int32;
           }
         }
       }
       container isis-sensor-ip-mpls {
         description
           "ISIS SPRING Per Sid egress sensor information";
         list isis-sensor-ip-mpls-entries {
           key "per-sid-sensor-name";
           leaf per-sid-sensor-name {
             type string;
           }
           leaf per-sid-sensor-id {
             type int32;
           }
         }
       }
     }
   }
   augment "/jgs:genstate" {
     description
       "Adds isis-spring-sensor-information container to top-level genstate 
       container";
     uses isis-spring-sensor-information-top;
   }
 }
