 module junos-genstate-evpn-instance-information {
   yang-version 1;
   namespace "http://yang.juniper.net/junos/genstate/evpn-instance-information";
   prefix jgeii;

   import junos-genstate {
     prefix jgs;
     revision-date 2026-01-01;
   }

   import junos-common-types {
     prefix jt;
     revision-date 2026-01-01;
   }

   organization
     "Juniper Networks, Inc.";

   contact
     "Juniper Networks, Inc.

      1133 Innovation Way
      Sunnyvale, CA 94089

      +1 888 314-5822

      E-mail: yang-support@juniper.net";

   description
      "Junos genstate Yang module for evpn-instance-information.

      Copyright (c) 2026 Juniper Networks, Inc.
      All rights reserved.";

   revision 2026-01-01 {
     description "Junos: 26.2R1.7";
   }

   grouping evpn-instance-information-top {
     description
       "Top-level grouping";
     container evpn-instance-information {
       description
         "Top-level container";
       list evpn-instance {
         key "evpn-instance-name";
