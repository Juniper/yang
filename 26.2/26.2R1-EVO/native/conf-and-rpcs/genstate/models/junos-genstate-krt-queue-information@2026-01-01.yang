 module junos-genstate-krt-queue-information {
   yang-version 1;
   namespace "http://yang.juniper.net/junos/genstate/krt-queue-information";
   prefix jgkqi;

   import junos-genstate {
     prefix jgs;
     revision-date 2026-01-01;
   }

   import junos-common-types {
     prefix jt;
     revision-date 2026-01-01;
   }

   organization
     "Juniper Networks, Inc.";

   contact
     "Juniper Networks, Inc.

      1133 Innovation Way
      Sunnyvale, CA 94089

      +1 888 314-5822

      E-mail: yang-support@juniper.net";

   description
      "Junos genstate Yang module for krt-queue-information.

      Copyright (c) 2026 Juniper Networks, Inc.
      All rights reserved.";

   revision 2026-01-01 {
     description "Junos: 26.2R1.7-EVO";
   }

   grouping krt-queue-information-top {
     description
       "Top-level grouping";
     container krt-queue-information {
       description
         "Top-level container";
       list krt-queue {
         key "krtq-type";
         description
           "KRT Queue";
         leaf krtq-type {
           type string;
         }
         leaf krtq-queue-length {
           type int32;
           description
             "Number of entries in this queue";
         }
         leaf krtq-gencfg-type {
           type int32;
           description
             "Gencfg Type stuck in the queue";
         }
         leaf krtq-entry-deleted {
           type empty;
           description
             "Entry in krt queue as deleted";
         }
         leaf krtq-unknown-entry {
           type int32;
           description
             "Queue entry of an unknown type";
         }
         list krtq-table-entry {
           description
             "Queue entry of type table";
           leaf krtq-operation {
             type string;
             description
               "Operation to be performed";
           }
           leaf krt-table-index {
             type int32;
             description
               "Table index";
           }
           leaf krtq-family {
             type int32;
             description
               "Address family";
           }
           leaf krtq-attempts {
             type int32;
             description
               "Number of attempts";
           }
           leaf krtq-error {
             type string;
             description
               "Reason for last failure";
           }
           leaf krt-queue-entry {
             type string;
             description
               "Krt queue entry Address";
           }
           leaf krtq-defer-time {
             type string;
             description
               "Kqp defer time";
           }
         }
